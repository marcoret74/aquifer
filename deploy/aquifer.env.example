# Configuración de ejemplo para Aquifer.
# Systemd (sistema): copiar a /etc/aquifer/aquifer.env
# Systemd (usuario): copiar a ~/.config/aquifer/aquifer.env
# Docker Compose: usar variables equivalentes en deploy/docker-compose.yml

AQUIFER_ROOT=/opt/aquifer
AQUIFER_MODEL=qwen05
AQUIFER_HOST=127.0.0.1
AQUIFER_PORT=8080
AQUIFER_CTX=2048
AQUIFER_THREADS=0

# Modelo y tokenizer (layout recomendado)
AQUIFER_MODELS_DIR=/srv/aquifer/models
# AQUIFER_ARTIFACT=/srv/aquifer/models/qwen05_affine
# AQUIFER_TOKENIZER=/srv/aquifer/models/qwen05/tokenizer.json
# AQUIFER_BIN=/opt/aquifer/build/generate_aquifer

# Seguridad
# AQUIFER_API_KEY=cambiame
# AQUIFER_RECEIPT_KEY=/etc/aquifer/receipt.key
# AQUIFER_TRACE_HMAC_KEY=/etc/aquifer/trace.key

# Herramientas server-side
AQUIFER_LOCAL_TOOLS=1
# AQUIFER_HTTP_TOOLS=/etc/aquifer/http-tools.json
# AQUIFER_HTTP_ALLOW_HOSTS=127.0.0.1,localhost
AQUIFER_MAX_TOOL_ROUNDS=2
AQUIFER_TOOL_BUDGET_MS=15000

# Evidencia y operación
AQUIFER_TRACE_LOG=/var/lib/aquifer/traces.jsonl
# AQUIFER_TRACE_CONTENT=1
# AQUIFER_CORS=1
# AQUIFER_TOKEN_TIMEOUT=45
# AQUIFER_TTFT_TIMEOUT=120
# AQUIFER_REQUEST_TIMEOUT=300
# AQUIFER_COMMAND_TIMEOUT=30
# AQUIFER_JSON_RETRIES=1

# Motor
# AQUIFER_KV_DTYPE=fp16
# AQUIFER_MEM_POLICY=auto
# AQUIFER_SPEC=4
# AQUIFER_TEMPERATURE=0
# AQUIFER_TOP_K=40
# AQUIFER_TOP_P=0.9
# AQUIFER_SEED=0
# AQUIFER_REPEAT_PENALTY=1.0
# AQUIFER_REPEAT_LAST_N=64

[Unit]
Description=Aquifer local inference API
Documentation=https://github.com/marcoret74/aquifer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aquifer
Group=aquifer
WorkingDirectory=/opt/aquifer
EnvironmentFile=/etc/aquifer/aquifer.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/aquifer/deploy/aquifer-serve.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillMode=control-group
StateDirectory=aquifer
StateDirectoryMode=0750
SyslogIdentifier=aquifer
StandardOutput=journal
StandardError=journal

# Endurecimiento
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
LimitNOFILE=65536
TasksMax=128

[Install]
WantedBy=multi-user.target
